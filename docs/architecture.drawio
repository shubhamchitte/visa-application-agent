<mxfile host="app.diagrams.net"><diagram id="arch" name="Architecture"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" page="1" pageWidth="1850" pageHeight="650"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Architecture: the LLM proposes, code decides" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;fillColor=none;strokeColor=none;fontSize=18;fontStyle=1;align=left" vertex="1" parent="1"><mxGeometry x="20" y="10" width="600" height="30" as="geometry"/></mxCell><mxCell id="n3" value="PROPOSES (LLM)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="640" y="12" width="130" height="26" as="geometry"/></mxCell><mxCell id="n4" value="DECIDES (deterministic code)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="780" y="12" width="200" height="26" as="geometry"/></mxCell><mxCell id="n5" value="data / artifact" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="990" y="12" width="110" height="26" as="geometry"/></mxCell><mxCell id="n6" value="rejected" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1110" y="12" width="80" height="26" as="geometry"/></mxCell><mxCell id="n7" value="Main pipeline (orchestrator.py run)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="10" y="60" width="1790" height="190" as="geometry"/></mxCell><mxCell id="n8" value="Packet folder&#10;(PDFs, png/jpg)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="130" height="130" as="geometry"/></mxCell><mxCell id="n9" value="1 INGEST&#10;pymupdf text per page, layout-sorted; no text layer -&gt; optional OCR (RapidOCR / tesseract, VISA_OCR)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="190" y="100" width="130" height="130" as="geometry"/></mxCell><mxCell id="n10" value="2 CLASSIFY&#10;content keywords (filename breaks ties)&#10;+ injection scan (regex flag)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="350" y="100" width="130" height="130" as="geometry"/></mxCell><mxCell id="n11" value="3 EXTRACT&#10;LLM: Groq gpt-oss-120b / replay / fake&#10;proposes value + quote + page" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="510" y="100" width="130" height="130" as="geometry"/></mxCell><mxCell id="n12" value="4 VERIFY&#10;quote on page + label anchor; value = whole token of quote (signed money); fail = value dropped" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="670" y="100" width="130" height="130" as="geometry"/></mxCell><mxCell id="n13" value="5 VALIDATE&#10;MRZ checks, expiry/travel dates, email format, letter date + leave, cross-doc identity (passport, form, bank holder, letter)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="830" y="100" width="130" height="130" as="geometry"/></mxCell><mxCell id="n14" value="6 CHECKLIST TOOL&#10;via gateway; failure = UNKNOWN" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="990" y="100" width="130" height="130" as="geometry"/></mxCell><mxCell id="n15" value="7 POLICY&#10;policy.yaml,